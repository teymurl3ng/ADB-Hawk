<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdbView.Tests</RootNamespace>
    <AssemblyName>AdbView.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- The xunit.v3.mtp-v2 package generates the Microsoft Testing Platform entry
         point (XunitAutoGeneratedEntryPoint); the SDK-generated one would collide. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdbView\AdbView.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\Adb\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdbView.Tests</RootNamespace>
    <AssemblyName>AdbView.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- The xunit.v3.mtp-v2 package generates the Microsoft Testing Platform entry
         point (XunitAutoGeneratedEntryPoint); the SDK-generated one would collide. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdbView\AdbView.csproj" />
    <ProjectReference Include="..\..\src\AdbView.Core\AdbView.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\CandidateOptions.cs" Link="Candidate\CandidateOptions.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\CandidateControlChannel.cs" Link="Candidate\CandidateControlChannel.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\CandidateRegistryRunKeyStore.cs" Link="Candidate\CandidateRegistryRunKeyStore.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\CandidatePreferenceController.cs" Link="Candidate\CandidatePreferenceController.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\CandidateRegistryPreferenceStore.cs" Link="Candidate\CandidateRegistryPreferenceStore.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\CandidateClock.cs" Link="Candidate\CandidateClock.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\LiveBackendSession.cs" Link="Candidate\LiveBackendSession.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\DispatchedNotificationSink.cs" Link="Candidate\DispatchedNotificationSink.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\Host\BubbleVisibility.cs" Link="Candidate\BubbleVisibility.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\NativeUi\Motion\MotionPolicy.cs" Link="Candidate\MotionPolicy.cs" />
    <Compile Include="..\..\src\AdbView.WinUiMigration\NativeUi\Motion\SurfaceTransitionController.cs" Link="Candidate\SurfaceTransitionController.cs" />
    <None Include="Fixtures\Adb\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

src/AdbView/wwwroot/

# Node
node_modules/
node_tool/

# Playwright run artifacts (committed baselines are NOT ignored)
ui/test-results/
ui/playwright-report/

# Visual Studio / Rider / VS Code local state
.vs/
.idea/
*.user
*.suo

# OS noise
Thumbs.db
.DS_Store


<Window
    x:Class="AdbView.WinUiMigration.CandidateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ADB View - WinUI candidate">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid MinHeight="48" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="Back" Visibility="Collapsed" VerticalAlignment="Center" MinHeight="32" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path x:Name="HeaderPhone" Width="18" Height="18" Stretch="Uniform" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
                    <TextBlock x:Name="AppTitle" Text="ADB View" FontFamily="Segoe UI Variable" FontSize="14.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="PinButton" Grid.Column="2" AutomationProperties.Name="Pin flyout" VerticalAlignment="Center" MinHeight="40" MinWidth="40" Padding="8" />
            </Grid>
            <Grid x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>

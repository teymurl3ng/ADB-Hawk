<UserControl x:Class="AdbView.NativeUi.Cards.DeviceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:motion="clr-namespace:AdbView.NativeUi.Motion"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- StaticResource inside card XAML resolves before the card is attached to the
                 shell tree, so the converter (and theme tokens) must be merged locally. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Device card: collapsed header+footer always visible; details expand in place (decision 0014-consistency). -->
    <Border CornerRadius="8" Background="{DynamicResource Win.Card}"
            BorderBrush="{DynamicResource Win.CardBorder}" BorderThickness="1"
            Padding="12" Cursor="{Binding CardCursor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Identity row (click expands) -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="OnHeaderClick"
                  Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Border CornerRadius="6" Background="{DynamicResource Win.GlyphBg}"
                                BorderBrush="{DynamicResource Win.GlyphBorder}" BorderThickness="1"/>
                        <Path Data="{DynamicResource Icon.Phone}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource Win.GlyphText}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text"
                                   Foreground="{DynamicResource Win.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding AgeText}" FontSize="12"
                                   Foreground="{DynamicResource Win.TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="24" Height="24" Padding="0" BorderThickness="0" Background="Transparent"
                        Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding ToggleExpandCommand}"
                        ToolTip="{Binding ChevronToolTip}" AutomationProperties.Name="{Binding ChevronToolTip}">
                    <!-- DESIGN 948: the chevron rotates over Motion.State (167 ms) on the frozen
                         shared curve while the height change itself is instant (decisions
                         0012/0013) - RenderTransform only. -->
                    <Path Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource Win.TextMuted}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ChevronRotation" Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 To="180" Duration="{StaticResource Motion.State}">
                                                    <DoubleAnimation.EasingFunction><motion:BezierEase/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation></Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 To="0" Duration="{StaticResource Motion.State}">
                                                    <DoubleAnimation.EasingFunction><motion:BezierEase/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation></Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </Grid>

            <!-- Status row -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="10" Padding="8,2"
                        Background="{Binding StatePillBackground}"
                        BorderBrush="{Binding StatePillBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatePillDot}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatePillText}" FontSize="12" FontWeight="Medium"
                                   Foreground="{Binding StatePillForeground}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,0"
                            Visibility="{Binding HasTransport, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="{Binding TransportIconGeometry}" Width="13" Height="13" Stretch="Uniform"
                          Stroke="{DynamicResource Win.TextSecondary}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TransportLabel}" FontSize="12"
                               Foreground="{DynamicResource Win.TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BatteryText}" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Win.TextValue}" VerticalAlignment="Center"/>
                    <Path Data="{DynamicResource Icon.Battery}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource Win.TextSecondary}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Expanded details: height instant (0012/0013); content fades in over Motion.State
                 (DESIGN 948 "detail opacity"). No fade-out - removal never delays truth (R-06). -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0"
                        Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDetails}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{StaticResource Motion.State}">
                                            <DoubleAnimation.EasingFunction><motion:BezierEase/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation></Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border BorderBrush="{DynamicResource Win.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <!-- Model -->
                        <Grid Margin="0,2,0,2" Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Model" FontSize="12" Foreground="{DynamicResource Win.TextMuted}"/>
                            <TextBlock Text="{Binding Model}" FontSize="12" Foreground="{DynamicResource Win.TextPrimary}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <!-- Android -->
                        <Grid Margin="0,2,0,2" Visibility="{Binding HasAndroid, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Android" FontSize="12" Foreground="{DynamicResource Win.TextMuted}"/>
                            <TextBlock Text="{Binding AndroidVersion}" FontSize="12" Foreground="{DynamicResource Win.TextPrimary}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <!-- Address -->
                        <Grid Margin="0,2,0,2" Visibility="{Binding HasAddress, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Address" FontSize="12" Foreground="{DynamicResource Win.TextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Address}" FontSize="11.5" FontFamily="Consolas"
                                           Foreground="{DynamicResource Win.TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Width="20" Height="20" Padding="0" BorderThickness="0" Background="Transparent"
                                        Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding CopyAddressCommand}"
                                        ToolTip="Copy Address" Visibility="{Binding ShowAddressCopy, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="{DynamicResource Icon.Copy}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource Win.TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <Border CornerRadius="4" Background="{DynamicResource Win.GreenSurface}"
                                        BorderBrush="{DynamicResource Win.GreenBorder}" BorderThickness="1" Padding="6,2"
                                        Visibility="{Binding ShowAddressCopied, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAddressCopied}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="{StaticResource Motion.Feedback}">
                                                                <DoubleAnimation.EasingFunction><motion:BezierEase/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation></Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource Icon.Check}" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{DynamicResource Win.GreenText}" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copied" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource Win.GreenText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!-- Serial -->
                        <Grid Margin="0,2,0,2" Visibility="{Binding HasSerial, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Serial" FontSize="12" Foreground="{DynamicResource Win.TextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Serial}" FontSize="11.5" FontFamily="Consolas"
                                           Foreground="{DynamicResource Win.TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Width="20" Height="20" Padding="0" BorderThickness="0" Background="Transparent"
                                        Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding CopySerialCommand}"
                                        ToolTip="Copy Serial" Visibility="{Binding ShowSerialCopy, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="{DynamicResource Icon.Copy}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource Win.TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <Border CornerRadius="4" Background="{DynamicResource Win.GreenSurface}"
                                        BorderBrush="{DynamicResource Win.GreenBorder}" BorderThickness="1" Padding="6,2"
                                        Visibility="{Binding ShowSerialCopied, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowSerialCopied}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="{StaticResource Motion.Feedback}">
                                                                <DoubleAnimation.EasingFunction><motion:BezierEase/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation></Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource Icon.Check}" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{DynamicResource Win.GreenText}" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copied" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource Win.GreenText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

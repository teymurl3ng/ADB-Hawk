<Window x:Class="AdbView.NativeUi.StatusBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADB View status"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MaxWidth="360">
    <!-- The window IS the bubble: a small square the size of the status dot, filled with the
         aggregate status colour and rounded by DWM (corner preference ROUNDSMALL). A true circle
         would need AllowsTransparency, i.e. the layered render path, which decision 0020 and
         research/2026-10-03 deliberately avoid. Hover expansion (phase N3) grows this window
         horizontally; the root element below is what carries the colour. -->
    <Border x:Name="Capsule" Width="22" Height="22" CornerRadius="4"
            BorderThickness="1" BorderBrush="{DynamicResource Win.BorderSubtle}"/>
</Window>

<UserControl x:Class="AdbView.NativeUi.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cards="clr-namespace:AdbView.NativeUi.Cards"
             xmlns:shell="clr-namespace:AdbView.NativeUi.Shell"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="376">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Stable shell (decision 0014-consistency): the layout never rebuilds — regions appear/disappear. -->
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: 40px, title + pin -->
        <Grid Grid.Row="0" Margin="16,0,16,0" MouseLeftButtonDown="OnHeaderDrag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.Phone}" Width="18" Height="18" Stretch="Uniform"
                      Stroke="{DynamicResource Win.Accent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock Text="ADB View" FontSize="13.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text"
                           Foreground="{DynamicResource Win.TextPrimary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <!-- DESIGN.md §5 asks for a ~40x40 interaction target; 36x36 is the largest that keeps
                 breathing room inside the 40px header. The glyph stays 14px. -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="36" Height="36" Padding="0" BorderThickness="0" Background="Transparent"
                    Cursor="Hand" Command="{Binding TogglePinCommand}"
                    ToolTip="{Binding PinToolTip}" FocusVisualStyle="{x:Null}">
                <Path Data="{Binding PinIconGeometry}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{Binding PinForeground}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>
        </Grid>

        <!-- Scroll region: content scrolls under the fixed header -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
            <StackPanel Margin="16,4,16,0">
                <!-- Existing global health contract; wording is supplied by the backend. -->
                <Border CornerRadius="8" BorderThickness="1" Padding="14" Margin="0,0,0,12"
                        Visibility="{Binding ShowGlobalHealth, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Win.AccentSurface}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Win.AccentBorder}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlobalHealth.Kind}" Value="AdbUnavailable">
                                    <Setter Property="Background" Value="{DynamicResource Win.RedSurface}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Win.RedBorder}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding GlobalHealth.Title}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win.TextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GlobalHealth.Detail}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win.TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GlobalHealth.Hint}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Win.TextSecondary}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GlobalHealth.Hint}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Empty state -->
                <Border CornerRadius="8" Background="{DynamicResource Win.Card}"
                        BorderBrush="{DynamicResource Win.CardBorder}" BorderThickness="1"
                        Padding="24" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border CornerRadius="20" Background="{DynamicResource Win.GlyphBg}"
                                    BorderBrush="{DynamicResource Win.GlyphBorder}" BorderThickness="1"/>
                            <Path Data="{StaticResource Icon.PhoneSlim}" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{DynamicResource Win.TextMuted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="No ADB devices" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win.TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Connect a device using USB or wireless debugging."
                                   FontSize="12" Foreground="{DynamicResource Win.TextSecondary}"
                                   TextAlignment="Center" MaxWidth="220" TextWrapping="Wrap" LineHeight="18"/>
                        <TextBlock Text="Wireless discovery active" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Win.TextSecondary}" HorizontalAlignment="Center"
                                   Visibility="{Binding ShowDiscoveryActive, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- QR entry: quiet full-width card button, visible whenever no pairing operation is active.
                     The card chrome belongs to the button itself (RowCardButton) so hover fills the whole
                     row at the card radius instead of leaving an inset fill edge inside the card. -->
                <Button Style="{StaticResource RowCardButton}"
                        Command="{Binding StartQrCommand}"
                        Visibility="{Binding ShowQrEntry, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10">
                        <Path Data="{DynamicResource Icon.Waves}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource Win.TextSecondary}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                        <TextBlock Text="Pair a device over Wi-Fi" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Win.TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Pairing QR session card. The wrapper owns visibility so the binding never
                     detaches when the card's own DataContext goes null (a null DataContext would
                     re-evaluate the Visibility binding to UnsetValue, i.e. visible). -->
                <Border Margin="0,12,0,0"
                        Visibility="{Binding ShowPairingQr, Converter={StaticResource BoolToVisibility}}">
                    <cards:PairingQrCardView DataContext="{Binding PairingQr}"/>
                </Border>

                <!-- Pairing operation card (phase-morphing; offer/code/progress/success/failure) -->
                <Border Margin="0,12,0,0"
                        Visibility="{Binding ShowPairingCard, Converter={StaticResource BoolToVisibility}}">
                    <shell:PairingCardView DataContext="{Binding PairingCard}"/>
                </Border>

                <!-- Device cards -->
                <ItemsControl ItemsSource="{Binding Devices}" Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <cards:DeviceCardView Margin="0,0,0,12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Discovery-health warning card (decision 0008): after devices, per DESIGN order -->
                <Border Margin="0,12,0,0"
                        Visibility="{Binding ShowDiscoveryHealth, Converter={StaticResource BoolToVisibility}}">
                    <shell:DiscoveryHealthCardView DataContext="{Binding DiscoveryHealth}"/>
                </Border>
                <!-- Existing local warning contract; it never rewrites device state. -->
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0"
                              Visibility="{Binding ShowSubsystemWarnings, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{DynamicResource Win.Card}"
                                    BorderBrush="{DynamicResource Win.CardBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Win.TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Win.TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

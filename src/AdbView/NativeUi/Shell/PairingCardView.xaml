<UserControl x:Class="AdbView.NativeUi.Shell.PairingCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style x:Key="SlotBox" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="{DynamicResource Win.SlotBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Win.SlotBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="36"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Win.RedBorder}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SlotText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Foreground" Value="{DynamicResource Win.TextPrimary}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="_">
                        <Setter Property="Foreground" Value="{DynamicResource Win.TextMuted}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Win.RedText}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Pairing card: ONE stable shell across phases; phase changes morph regions, not the host. -->
    <Border CornerRadius="8" Background="{Binding CardSurface}"
            BorderBrush="{Binding CardBorder}" BorderThickness="1" Padding="14">
        <StackPanel>
            <!-- Header / identity region -->
            <StackPanel>
                <!-- Offer -->
                <StackPanel Visibility="{Binding IsOffer, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" VerticalAlignment="Top">
                            <Border CornerRadius="6" Background="{DynamicResource Win.AccentSurface}"
                                    BorderBrush="{DynamicResource Win.AccentBorder}" BorderThickness="1"/>
                            <Path Data="{DynamicResource Icon.Waves}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource Win.Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Win.Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Wireless pairing available" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Win.TextPrimary}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceNameDisplay}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource Win.TextPrimary}" Margin="0,4,0,0"/>
                            <TextBlock Text="Waiting for a pairing code" FontSize="12"
                                       Foreground="{DynamicResource Win.TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Cursor="Hand" FocusVisualStyle="{x:Null}" Padding="0"
                            Command="{Binding StartCommand}">
                        <Border CornerRadius="4" Background="{DynamicResource Win.Accent}" Height="28" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Pair" FontSize="12" FontWeight="Medium" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Path Data="{DynamicResource Icon.ArrowRight}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Success -->
                <StackPanel Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                            <Border CornerRadius="16" Background="{DynamicResource Win.GreenSurface}"
                                    BorderBrush="{DynamicResource Win.GreenBorder}" BorderThickness="1"/>
                            <Path Data="{DynamicResource Icon.Check}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource Win.GreenText}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SuccessTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Win.TextPrimary}"/>
                            <TextBlock Text="Waiting for ADB connection…" FontSize="12"
                                       Foreground="{DynamicResource Win.TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Progress -->
                <StackPanel Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Ellipse Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,12"
                             StrokeThickness="2" Stroke="{DynamicResource Win.AccentBorder}"/>
                    <TextBlock Text="{Binding HeaderText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Win.TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Keep the phone nearby while pairing completes." FontSize="12"
                               Foreground="{DynamicResource Win.TextSecondary}" TextAlignment="Center"
                               MaxWidth="260" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Failure -->
                <StackPanel Visibility="{Binding IsFailure, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                            Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="28" Height="28" VerticalAlignment="Top">
                            <Border CornerRadius="14" Background="{DynamicResource Win.RedSurface}"
                                    BorderBrush="{DynamicResource Win.RedBorder}" BorderThickness="1"/>
                            <Path Data="{DynamicResource Icon.Alert}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource Win.RedText}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBlock Text="Pairing failed" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Win.TextPrimary}"/>
                            <TextBlock Text="{Binding DetailText}" FontSize="12"
                                       Foreground="{DynamicResource Win.TextSecondary}" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Code-entry title (code phases except failure) -->
                <StackPanel Visibility="{Binding ShowCodeEntryTitle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Grid>
                        <TextBlock Text="{Binding DeviceNameDisplay}" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Win.TextPrimary}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Wi-Fi Pairing" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource Win.Accent}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Enter the six-digit code shown on the phone." FontSize="12"
                               Foreground="{DynamicResource Win.TextSecondary}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Content region: six code slots with an invisible digit input on top -->
            <Grid Visibility="{Binding IsCodeEntry, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SlotBox}">
                    <TextBlock Style="{StaticResource SlotText}" Text="{Binding Digit1}"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SlotBox}">
                    <TextBlock Style="{StaticResource SlotText}" Text="{Binding Digit2}"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource SlotBox}">
                    <TextBlock Style="{StaticResource SlotText}" Text="{Binding Digit3}"/>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource SlotBox}">
                    <TextBlock Style="{StaticResource SlotText}" Text="{Binding Digit4}"/>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource SlotBox}">
                    <TextBlock Style="{StaticResource SlotText}" Text="{Binding Digit5}"/>
                </Border>
                <Border Grid.Column="10" Style="{StaticResource SlotBox}">
                    <TextBlock Style="{StaticResource SlotText}" Text="{Binding Digit6}"/>
                </Border>
                <!-- Invisible input: carries focus and keyboard like the WebView hidden input. -->
                <TextBox Grid.Column="0" Grid.ColumnSpan="11" x:Name="CodeInputBox"
                         Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}"
                         Opacity="0" Background="Transparent" BorderThickness="0"
                         CaretBrush="Transparent" SelectionBrush="Transparent" MinWidth="0" MinHeight="0"
                         MaxLength="32" FontSize="1" Height="36"
                         IsVisibleChanged="OnCodeInputVisibleChanged"/>
            </Grid>

            <!-- Action region -->
            <StackPanel>
                <!-- Progress: full-width quiet cancel -->
                <Button Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" FocusVisualStyle="{x:Null}" Padding="0" Margin="0,12,0,0"
                        Command="{Binding CancelCommand}">
                    <Border BorderBrush="{DynamicResource Win.BorderSubtle}" BorderThickness="0,1,0,0"
                            Padding="0,8,0,0">
                        <TextBlock Text="Cancel pairing" FontSize="11.5"
                                   Foreground="{DynamicResource Win.TextSecondary}" HorizontalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Code entry: Cancel + Pair/Retry over a subtle top rule -->
                <Grid Visibility="{Binding IsCodeEntry, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                      Margin="0,12,0,0">
                    <Border BorderBrush="{DynamicResource Win.BorderSubtle}" BorderThickness="0,1,0,0"
                            Padding="0,8,0,0"/>
                    <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FocusVisualStyle="{x:Null}" Padding="10,0" Height="28"
                            Command="{Binding CancelCommand}">
                        <TextBlock Text="Cancel" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource Win.TextSecondary}"/>
                    </Button>
                    <Button HorizontalAlignment="Right" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Padding="0" Height="28" Command="{Binding SubmitCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border CornerRadius="4" Background="{Binding SubmitBackground}" Height="28" Padding="14,0">
                            <TextBlock Text="Pair" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="{Binding SubmitForeground}"/>
                        </Border>
                    </Button>
                    <Button HorizontalAlignment="Right" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Padding="0" Height="28" Command="{Binding RetryCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border CornerRadius="4" Background="{DynamicResource Win.Red}" Height="28" Padding="14,0">
                            <TextBlock Text="Retry" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
